{
  "name": "classi-ai-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Classiのスクリーンショットから課題・期限を整理し、AIへの質問文を作るブラウザアプリ",
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=ipad-air-portrait --project=ipad-air-landscape",
    "test:splitview": "playwright test --project=split-view",
    "test:ocr": "playwright test --project=ocr",
    "test:ocr:online": "OCR_ONLINE=1 playwright test --project=ocr",
    "check:syntax": "node tests/check-syntax.js",
    "serve": "node tests/server.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/jpn": "1.0.0",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1"
  }
}
