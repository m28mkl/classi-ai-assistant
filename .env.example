# AI解説サーバー用の設定の見本。本物の値を入れたファイルは Git に入れないでください（.env は .gitignore 済み）。
# サーバーを動かすサービスの「環境変数」の設定画面に、同じ名前で登録します。

# 必須：OpenAIのAPIキー（画面・GitHubには絶対に書かない）
OPENAI_API_KEY=

# 必須：画面で入力する「利用コード」。長くて推測されにくい文字列にする
ACCESS_CODE=

# 画面をGitHub Pagesで公開するときのURL（CORS）。サーバーから画面も配るなら不要
ALLOWED_ORIGIN=https://m28mkl.github.io

# 任意（初期値）
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=low
# MAX_INPUT_TOKENS=4000
# MAX_OUTPUT_TOKENS=800
# DAILY_MAX_CALLS=50
# MONTHLY_STOP_JPY=300
# PRICING_FILE=server/pricing.json
# DATA_DIR=server/data
# SERVE_STATIC=1
